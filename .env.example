# =============================================================================
# CONFIGURAÇÕES DE PRODUÇÃO (VPS HRF ECOSYSTEM + MYSQL) - SENAI MSEP
# =============================================================================

NODE_ENV=production
PORT=3000
APP_NAME=Sistema Integrado de Gestão e Avaliação SENAI

# Porta externa na VPS (3004 está livre! 3000, 3001, 3002 e 3003 já estão em uso)
APP_PORT=3004

# Mecanismo de Banco de Dados: 'mysql'
DB_TYPE=mysql

# Conexão com o container mysql-db já existente na sua VPS (porta 3307 mapeada no host)
DB_HOST=172.17.0.1
DB_PORT=3307
DB_NAME=avaliacao_senai
DB_USER=root
DB_PASSWORD=SUA_SENHA_ROOT_DO_MYSQL_DB
