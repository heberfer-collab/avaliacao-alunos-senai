{
  "rewrites": [
    {
      "source": "/api/users",
      "destination": "/api/users.js"
    },
    {
      "source": "/api/projetos",
      "destination": "/api/projetos.js"
    },
    {
      "source": "/api/timesheet",
      "destination": "/api/timesheet.js"
    },
    {
      "source": "/api/app-state",
      "destination": "/api/app-state.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}